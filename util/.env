# Super scary stuff was this .env file supposed to be committed!!!
# This is a proof of concept only. Do not reuse these values,

# Vault
VAULT_ROOT_TOKEN=root

# Woodpecker <-> Gitea creds
# I'd have auto-populated these but they're generated on first setup.
# Need to be filled in after creating the OAuth2 app in Gitea
# (Settings -> Applications -> redirect URI: http://woodpecker.localhost/authorize)
WOODPECKER_GITEA_CLIENT=changeme_client_id
WOODPECKER_GITEA_SECRET=changeme_client_secret

# Woodpecker Server <-> Woodpecker Agent
WOODPECKER_AGENT_SECRET=a7db4def08cb2963b4f2f5d39be56ee5151fbdb22f352872019d5b942c15b7
